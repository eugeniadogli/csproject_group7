'''
step 3: Handle duplicates
# Even though the generator produces clean data, treat this step seriously —
'''

if utilities.isnull().sum().sum() > 0:
    print("utilities.csv has missing values")
    print(utilities.isnull().sum())
else:
    print("utilities.csv has no missing values")

if utilities.duplicated().sum() > 0:
    print("utilities.csv has duplicates")
    utilities = utilities.drop_duplicates()
else:
    print("utilities.csv has no duplicates")
